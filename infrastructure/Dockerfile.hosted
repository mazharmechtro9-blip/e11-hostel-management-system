FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; \
    npm ci --no-audit --no-fund
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM python:3.12-slim-bookworm AS python-dependencies
WORKDIR /dependencies
COPY backend/requirements.lock ./
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca; fi; \
    pip install --no-cache-dir --prefix=/installed -r requirements.lock

FROM python:3.12-slim-bookworm AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libatomic1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 hostel
COPY --from=web /usr/local/bin/node /usr/local/bin/node
COPY --from=python-dependencies /installed /usr/local
WORKDIR /app
COPY --chown=hostel:hostel backend/ ./backend/
COPY --from=web --chown=hostel:hostel /web/.next/standalone ./frontend/
COPY --from=web --chown=hostel:hostel /web/.next/static ./frontend/.next/static/
COPY --from=web --chown=hostel:hostel /web/public ./frontend/public/
COPY --chown=hostel:hostel infrastructure/run_hosted.py ./run_hosted.py
RUN mkdir -p /app/backend/private-storage && chown hostel:hostel /app/backend/private-storage
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER hostel
EXPOSE 10000
CMD ["python", "/app/run_hosted.py"]
