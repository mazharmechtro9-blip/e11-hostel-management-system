{
  "name": "E-11 Hostel Browser Preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "remoteUser": "vscode",
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "E-11 HOSTEL — OPEN PORTAL",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "postCreateCommand": "bash scripts/codespaces-setup.sh",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "settings": { "workbench.startupEditor": "none" }
    }
  }
}
